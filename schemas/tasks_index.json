{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zhangtaolab/dnallmmark/main/schemas/tasks_index.json",
  "$comment": "Fully strict contract (D-01) for dnallm-mark/data/tasks.json (the lightweight task index generated by scripts/generate-tasks-index.js). Closed enums duplicated inline per D-02 — species/type/metric use the same vocabulary as the dataset blocks in model_performance.json and task_performance.json. An empty tasks array with count 0 is valid (the generator on an empty task_performance/ dir); a missing required key is not. Entry shape surveyed live from the committed index (Phase 2 research, 2026-10-09).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "count", "tasks"],
  "properties": {
    "version": { "type": "string" },
    "count": { "type": "integer" },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "displayName",
          "species",
          "type",
          "labels",
          "length",
          "metric",
          "fileName"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "displayName": { "type": "string" },
          "species": { "enum": ["Animals", "Plants", "Microbe"] },
          "type": { "enum": ["binary", "multiclass", "regression", "multilabel"] },
          "labels": { "type": "integer" },
          "length": { "type": "integer" },
          "metric": { "enum": ["f1", "mcc", "spearmanr", "AUPRC"] },
          "fileName": { "type": "string" }
        }
      }
    }
  }
}
