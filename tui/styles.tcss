/*
 * ===== styles.tcss — DNALLM-Mark console styles (Phase 8; 08-02 base,
 * 08-06 complete) =====
 *
 * Contract (08-UI-SPEC Color + Spacing Scale + Typography, approved
 * 2026-10-11):
 *
 * - Semantic Textual theme tokens ONLY — $background, $surface, $panel,
 *   $boost, $accent, $success, $warning, $error, $text, $text-muted,
 *   $border — which adapt to light/dark/NO_COLOR automatically. Hardcoded
 *   hex is forbidden; the single permitted hex site (the optional
 *   `dnallmmark` brand-teal theme) is deliberately NOT landed — default
 *   theme tokens satisfy the contract unchanged.
 * - Spacing uses ONLY the declared terminal-cell tokens: md = 4 cells
 *   (padding: 1 4 panels/modals), plus the documented exceptions — 1-cell
 *   widget borders, and `padding: 0 1`/`0 2` on status lines. No invented
 *   intermediate paddings (no 3/5/6-cell values anywhere).
 * - Typography: exactly two weights — regular (body) and bold (heading +
 *   emphasis roles); no italics, underline, or blink. CJK copy counts
 *   double width; all measurement is Textual/Rich's.
 * - Every color-coded state carries its glyph first (the constants carry
 *   ✓/✗/⚠/◌/⠋) — the UI stays legible under NO_COLOR; color here is the
 *   redundant second channel.
 */

/* ===== Header / Footer surfaces =====
 * Textual's built-in Header/Footer already render on semantic theme
 * variables ($surface-family + $accent keycaps); no overrides needed. */

/* ===== Env-check screen: title bar (status line) ===== */

#env-title-bar {
    height: 1;      /* row token: one status line */
    padding: 0 2;   /* 2-cell status-line exception */
}

#env-screen-title {
    text-style: bold;          /* Heading role */
    width: auto;
}

#env-last-check {
    width: 1fr;                /* right edge of the same status line */
    text-align: right;
    color: $text-muted;        /* Secondary role */
}

/* ===== Env-check screen: kernel table ===== */

#env-kernels {
    height: 1fr;   /* the table owns every remaining row; scrolls below */
}

/* Table header: bold + $text-muted on $surface (Typography + Color) */
#env-kernels > .datatable--header {
    text-style: bold;
    color: $text-muted;
    background: $surface;
}

/* ===== Env-check screen: verdict / routing block ===== */

#env-verdict {
    height: auto;
    border-top: solid $border;   /* 1-cell border exception — separator */
    padding: 1 4;                /* md token: panel padding */
}

.verdict-pass {
    color: $success;
    text-style: bold;            /* Emphasis role */
}

.verdict-fail {
    color: $error;
    text-style: bold;            /* Emphasis role */
}

.verdict-route {
    color: $warning;
}

/* ===== Modals (env drill-down + help) ===== */

EnvDetailModal,
HelpModal {
    align: center middle;        /* the bordered box centers on screen */
}

#env-detail-box,
#help-box {
    width: 60;                   /* modal token (min(60, width-4) narrow) */
    height: auto;
    padding: 1 4;                /* modal token */
    border: solid $accent;       /* 1-cell border exception */
    background: $surface;
}

/* Bounded so the log scrolls its own viewport (wrap + scroll, never
 * elide); a height cap is not a spacing token — the padding prohibition
 * governs paddings, and the bound matches the min-screen height class. */
#env-detail-log {
    height: auto;
    max-height: 20;
}

/* ===== Selection screen (08-07) ===== */

#selection-title-bar {
    height: 1;      /* row token: one status line */
    padding: 0 2;   /* 2-cell status-line exception */
}

#selection-screen-title {
    text-style: bold;          /* Heading role */
    width: auto;
}

#selection-status {
    width: 1fr;                /* right edge of the same status line */
    text-align: right;
    color: $text-muted;        /* Secondary role */
}

#selection-filter-bar {
    height: 1;      /* the compact Input renders one row */
    padding: 0 1;   /* 1-cell status-line exception */
}

#selection-filter-label {
    width: auto;
    color: $text-muted;        /* Secondary role */
}

#selection-filter {
    width: 1fr;                /* the Input owns the bar's remaining width */
}

#selection-filter-count {
    width: auto;               /* the (N/total) readout right-aligns after it */
    color: $text-muted;        /* Secondary role */
}

#selection-filter-warning {
    height: 1;      /* reserved row — the layout never jumps */
    padding: 0 2;   /* 2-cell status-line exception */
    color: $warning;
}

#selection-table {
    height: 1fr;    /* the table owns every remaining row; scrolls below */
}

#selection-table > .datatable--header {
    text-style: bold;
    color: $text-muted;
    background: $surface;
}

/* ===== Matrix overview screen (08-07, Task 2) ===== */

#matrix-title-bar {
    height: 1;      /* row token: one status line */
    padding: 0 2;   /* 2-cell status-line exception */
}

#matrix-screen-title {
    text-style: bold;          /* Heading role */
    width: auto;
}

#matrix-scroll-hint {
    width: 1fr;                /* the hint right-aligns on the same line */
    text-align: right;
    color: $text-muted;        /* Secondary role */
}

#matrix-table {
    height: 1fr;    /* the grid owns every remaining row; scrolls below */
}

#matrix-table > .datatable--header {
    text-style: bold;
    color: $text-muted;
    background: $surface;
}

#matrix-readout {
    height: 1;      /* row token: the cursor readout line below the grid */
    padding: 0 2;   /* 2-cell status-line exception */
    color: $text-muted;        /* Secondary role */
}

#matrix-empty {
    padding: 1 4;   /* md token: the empty-state copy sits like a panel */
    color: $warning;
}

/* ===== Selection/matrix modals (08-07) — the shared box pattern ===== */

PresetModal,
TemplateMenuModal,
PathInputModal,
ConfirmModal,
RowDetailModal,
MatrixKeyModal {
    align: center middle;      /* the bordered box centers on screen */
}

.modal-box {
    width: 60;                   /* modal token (min(60, width-4) narrow) */
    height: auto;
    padding: 1 4;                /* modal token */
    border: solid $accent;       /* 1-cell border exception */
    background: $surface;
}

#row-detail-log {
    height: auto;
    max-height: 20;   /* scroll bound (not a spacing token) — wrap, never elide */
}

#matrix-key-log {
    height: auto;
    max-height: 20;   /* scroll bound (not a spacing token) — wrap, never elide */
}

/* ===== Min-size guard screen ===== */

MinSizeScreen {
    align: center middle;        /* the message is the ONLY content */
}

#min-size-message {
    text-style: bold;
    color: $warning;
    padding: 0 2;                /* 2-cell status-line exception */
}

/* ===== 关于屏 (09-03, D-13 slot 6) ===== */

#about-box {
    padding: 1 4;                /* md token: the rows sit like a panel */
}

#about-title {
    text-style: bold;            /* Heading role */
    height: 1;                   /* row token */
}

.about-row {
    height: auto;                /* wrapping values grow the row, never elide */
}

.about-label {
    width: 10;                   /* fixed 8-cell CJK label + 2-cell gap */
    height: auto;
}

.about-value {
    width: 1fr;                  /* the wrapping value column */
    height: auto;
}
