# Snapshot tars (06-04, OQ 2): deposition artifacts stay untracked; only
# the .sha256 manifests under baseline/snapshots/ are committed as
# tamper-evidence (mirrors baseline/data-v1.sha256). The global *.tar rule
# above already ignores them; this entry documents the intent and stays
# correct if that rule is ever narrowed.
baseline/snapshots/*.tar

results/

.ruff_cache/

# Project specific (benchmark data — downloaded/produced by the pipeline, never committed)
datasets/
models/
finetuned/
# ...except the committed canned-replay fixture tree (Phase 5, REV-06 Q1):
# re-include the directory itself FIRST (git does not descend into an
# ignored directory, so a child-only negation can never match), then its
# contents — tests/test_ci_replay.py replays this exact tree in CI.
!tests/fixtures/e2_replay/finetuned/
!tests/fixtures/e2_replay/finetuned/**

# Worktrees
.worktrees/
worktrees/

# GSD planning scratch (untracked runtime noise)
.planning/tmp/


# GSD research dedup cache (ephemeral, tool-internal)
.planning/research/.cache/

# Reviewer response report (maintainer-only, never committed)
reviewer-response/
# Smoke output roots, fresh per launch (15-01 continuation: the halted
# first smoke's root is preserved as evidence; re-runs use suffixed roots)
finetuned-smoke*/
# Subset smoke roots (15-02, D15-07 third registry class): generator
# output + subset registry — isolated from official AND custom registries
pipeline/datasets-smoke/
pipeline/registry-smoke/
# Small real sweep root (15-03, D15-09/D15-10): own dispatch root separate
# from the smoke roots — the identical cell key plant-dnabert-6mer/
# iDNA_ABF_datasets__5mC/seed_42 exists in BOTH runs (full-data smoke vs
# subset sweep); a shared root would skip sweep cells on the smoke's
# trainer_state markers (adjacency edge, pinned by skipped == 0)
pipeline/finetuned-sweep/
# Fresh re-run sweep root (15-03 continuation after 15-05's WINDOWS #45
# producer fix): the original finetuned-sweep root is preserved superseded
# evidence (eval-less final_metrics) — its trainer_state markers would
# resume-skip all 12 cells, so the eval-carrying re-run needs its own root
pipeline/finetuned-sweep-r2/
# TUI demo meta sidecars (quick-261015-pex): per-recording driver state,
# consumed by record.sh's exit gate — never committed.
docs/demo/.meta-*.json

# Storage landing paths (261017 audit): the repo-root HF cache default
# (run_finetune module-top default; multi-GB on first write) and the
# documented demo output root — never committable.
cache/
finetuned-demo/
